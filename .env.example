# Copy to .env. These three keys are required by the current TARZ setup.
GROQ_API_KEY_1=
GEMINI_KEY_1=
JINA_API_KEY=

# Optional provider fallbacks and extra keys for rate-limit rotation.
OPENROUTER_API_KEY=
# Set false only when your GEMINI_KEY_* values belong to separate Google projects.
GEMINI_KEYS_SHARE_PROJECT=true
NVIDIA_API_KEY=
# Optional aliases if you prefer numbered key names:
# NVIDIA_API_KEY_1=
# NVIDIA_API_KEY_2=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_THINKING=1
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
OPENROUTER_API_KEY_2=

# Optional feature keys.
GROQ_VISION_KEY_1=
GROQ_VISION_KEY_2=
MOONDREAM_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_KEY=
CARTESIA_API_KEY=

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Tarz
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
